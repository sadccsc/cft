<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1005</width><height>600</height></rect>
  </property>
  <property name="windowTitle">
   <string>CFT products</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayout">
    <item>
     <widget class="QSplitter" name="splitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>
      <widget class="QScrollArea" name="scrollArea">
       <property name="widgetResizable"><bool>true</bool></property>
       <widget class="QWidget" name="scrollAreaWidgetContents">
        <layout class="QVBoxLayout" name="verticalLayoutLeft">

         <item>
          <layout class="QHBoxLayout" name="horizontalLayout_outdir">
           <item>
            <widget class="QLabel" name="label_outdir">
             <property name="text"><string>Output Directory:</string></property>
            </widget>
           </item>
           <item>
            <widget class="QLineEdit" name="lineEdit_outdir">
             <property name="readOnly"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="pushButton_outdir">
             <property name="text"><string>Browse...</string></property>
            </widget>
           </item>
          </layout>
         </item>

         <item>
          <widget class="QGroupBox" name="groupBox_obs">
           <property name="title"><string>Observations (daily, .nc grid or .csv stations)</string></property>
           <layout class="QGridLayout" name="gridLayout_obs">
            <item row="0" column="0">
             <widget class="QLabel" name="label_obsfile">
              <property name="text"><string>Data file:</string></property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QLineEdit" name="lineEdit_obsfile">
              <property name="readOnly"><bool>true</bool></property>
             </widget>
            </item>
            <item row="0" column="2">
             <widget class="QPushButton" name="pushButton_obsfile">
              <property name="text"><string>Browse...</string></property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="label_obsvar">
              <property name="text"><string>Variable</string></property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QComboBox" name="comboBox_obsvar"/>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="label_missing">
              <property name="text"><string>Missing value code</string></property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="QLineEdit" name="lineEdit_obsmissingvalue"/>
            </item>
            <item row="3" column="0">
             <widget class="QLabel" name="label_dsetcode">
              <property name="text"><string>Dataset code</string></property>
             </widget>
            </item>
            <item row="3" column="1">
             <widget class="QLineEdit" name="lineEdit_dsetcode">
              <property name="toolTip"><string>user-defined code used in the names of output files</string></property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupBox_clim">
           <property name="title"><string>Climatological reference</string></property>
           <layout class="QFormLayout" name="formLayout_clim">
            <item row="0" column="0">
             <widget class="QLabel" name="label_climstart">
              <property name="text"><string>Climatology start year:</string></property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QLineEdit" name="lineEdit_climstartyr"/>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="label_climend">
              <property name="text"><string>Climatology end year:</string></property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QLineEdit" name="lineEdit_climendyr"/>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupBox_onset">
           <property name="title"><string>Agronomic onset</string></property>
           <layout class="QGridLayout" name="gridLayout_onset">
            <item row="0" column="0">
             <widget class="QLabel" name="label_regimefile">
              <property name="text"><string>Regime map (optional):</string></property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QLineEdit" name="lineEdit_regimefile">
              <property name="toolTip"><string>netcdf map coded 1 - summer, 2 - winter rainfall. Leave empty to derive regime from data</string></property>
             </widget>
            </item>
            <item row="0" column="2">
             <widget class="QPushButton" name="pushButton_regimefile">
              <property name="text"><string>Browse...</string></property>
             </widget>
            </item>
            <item row="1" column="0" colspan="3">
             <layout class="QGridLayout" name="gridLayout_season">
               <item row="0" column="0">
                <widget class="QLabel" name="label_summerstart">
                 <property name="text"><string>Summer rainfall - season start:</string></property>
                </widget>
               </item>
               <item row="0" column="1">
                <widget class="QComboBox" name="comboBox_summerstart">
                 <property name="toolTip"><string>onset is searched from day 1 of this month; should fall in the dry season</string></property>
                 <property name="currentIndex"><number>9</number></property>
                 <item><property name="text"><string>Jan</string></property></item>
                 <item><property name="text"><string>Feb</string></property></item>
                 <item><property name="text"><string>Mar</string></property></item>
                 <item><property name="text"><string>Apr</string></property></item>
                 <item><property name="text"><string>May</string></property></item>
                 <item><property name="text"><string>Jun</string></property></item>
                 <item><property name="text"><string>Jul</string></property></item>
                 <item><property name="text"><string>Aug</string></property></item>
                 <item><property name="text"><string>Sep</string></property></item>
                 <item><property name="text"><string>Oct</string></property></item>
                 <item><property name="text"><string>Nov</string></property></item>
                 <item><property name="text"><string>Dec</string></property></item>
                </widget>
               </item>
               <item row="0" column="2">
                <widget class="QLabel" name="label_summerdays">
                 <property name="text"><string>search window:</string></property>
                </widget>
               </item>
               <item row="0" column="3">
                <widget class="QSpinBox" name="spinBox_summerdays">
                 <property name="toolTip"><string>number of days from season start in which onset is searched; later onset is reported as no onset (-99)</string></property>
                 <property name="suffix"><string> days</string></property>
                 <property name="minimum"><number>30</number></property>
                 <property name="maximum"><number>365</number></property>
                 <property name="value"><number>123</number></property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="label_winterstart">
                 <property name="text"><string>Winter rainfall - season start:</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QComboBox" name="comboBox_winterstart">
                 <property name="toolTip"><string>onset is searched from day 1 of this month; should fall in the dry season</string></property>
                 <property name="currentIndex"><number>2</number></property>
                 <item><property name="text"><string>Jan</string></property></item>
                 <item><property name="text"><string>Feb</string></property></item>
                 <item><property name="text"><string>Mar</string></property></item>
                 <item><property name="text"><string>Apr</string></property></item>
                 <item><property name="text"><string>May</string></property></item>
                 <item><property name="text"><string>Jun</string></property></item>
                 <item><property name="text"><string>Jul</string></property></item>
                 <item><property name="text"><string>Aug</string></property></item>
                 <item><property name="text"><string>Sep</string></property></item>
                 <item><property name="text"><string>Oct</string></property></item>
                 <item><property name="text"><string>Nov</string></property></item>
                 <item><property name="text"><string>Dec</string></property></item>
                </widget>
               </item>
               <item row="1" column="2">
                <widget class="QLabel" name="label_winterdays">
                 <property name="text"><string>search window:</string></property>
                </widget>
               </item>
               <item row="1" column="3">
                <widget class="QSpinBox" name="spinBox_winterdays">
                 <property name="toolTip"><string>number of days from season start in which onset is searched; later onset is reported as no onset (-99)</string></property>
                 <property name="suffix"><string> days</string></property>
                 <property name="minimum"><number>30</number></property>
                 <property name="maximum"><number>365</number></property>
                 <property name="value"><number>153</number></property>
                </widget>
               </item>
             </layout>
            </item>
            <item row="2" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetTadross">
              <property name="text"><string>Tadross et al. (2005): 25 mm in 10 day, followed by 20mm in the next 20 days</string></property>
              <property name="toolTip"><string>at least 25 mm of accumulated rainfall in 10 days, followed by at least 20 mm of accumulated rainfall in the following 20 days </string></property>
             </widget>
            </item>
            <item row="3" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetAngola">
              <property name="text"><string>Angola: 25 mm in 10 days, followed by 20 mm in the next 20 days</string></property>
              <property name="toolTip"><string>at least 25 mm of accumulated rainfall in 10 days, followed by at least 20 mm of accumulated rainfall in the following 20 days</string></property>
             </widget>
            </item>
            <item row="4" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetBotswana">
              <property name="text"><string>Botswana (Sivakumar 1988): 20 mm in 3 days, no 7-day dry spell in the following 30 days</string></property>
              <property name="toolTip"><string>at least 20 mm of accumulated rainfall in 3 days, not followed by a period of 7 consecutive days with rainfall &lt; 1 mm in the following 30 days (Sivakumar 1988)</string></property>
             </widget>
            </item>
            <item row="5" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetEswatini">
              <property name="text"><string>Eswatini (Sivakumar 1988): 20 mm in 3 days, no 7-day dry spell in the following 30 days</string></property>
              <property name="toolTip"><string>at least 20 mm of accumulated rainfall in 3 days, with no check for a following dry spell</string></property>
             </widget>
            </item>
            <item row="6" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetLesotho">
              <property name="text"><string>Lesotho: more than 25 mm in 5 days, no 10-day dry spell in the following 21 days</string></property>
              <property name="toolTip"><string>more than 25 mm of accumulated rainfall in 5 days, not followed by a period of 10 consecutive days with rainfall &lt; 1 mm in the following 21 days</string></property>
             </widget>
            </item>
            <item row="7" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetMadagascar">
              <property name="text"><string>Madagascar: 20 mm in 2 days, no dry spell longer than 10 days in the following 30 days</string></property>
              <property name="toolTip"><string>at least 20 mm of accumulated rainfall in 2 days, not followed by a period of more than 10 consecutive days with rainfall &lt; 1 mm in the following 30 days</string></property>
             </widget>
            </item>
            <item row="8" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetMalawi">
              <property name="text"><string>Malawi: 25 mm in 3 days, no 10-day dry spell in the following 21 days</string></property>
              <property name="toolTip"><string>at least 25 mm of accumulated rainfall in 3 days, not followed by a period of 10 consecutive days with rainfall &lt; 1 mm in the following 21 days</string></property>
             </widget>
            </item>
            <item row="9" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetMozambique">
              <property name="text"><string>Mozambique: 20 mm in 3 days, no 10-day dry spell in the following 21 days</string></property>
              <property name="toolTip"><string>at least 20 mm of accumulated rainfall in 3 days, not followed by a period of 10 consecutive days with rainfall &lt; 1 mm in the following 21 days</string></property>
             </widget>
            </item>
            <item row="10" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetNamibia">
              <property name="text"><string>Namibia: 10 mm in 10 days starting on a rainy day, with at least 2 rainy days</string></property>
              <property name="toolTip"><string>first day with rainfall &gt;= 0.1 mm on which the 10 days starting that day accumulate at least 10 mm, with at least 2 of those days having &gt;= 0.1 mm (returns the first day of the 10-day window, not the last)</string></property>
             </widget>
            </item>
            <item row="11" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetSouthAfrica">
              <property name="text"><string>South Africa: 25 mm in 5 days, no 10-day dry spell in the following 21 days</string></property>
              <property name="toolTip"><string>at least 25 mm of accumulated rainfall in 5 days, not followed by a period of 10 consecutive days with rainfall &lt; 1 mm in the following 21 days</string></property>
             </widget>
            </item>
            <item row="12" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetTanzania">
              <property name="text"><string>Tanzania: more than 20 mm in 4 days with 2 wet days, no 10-day dry spell in the following 30 days</string></property>
              <property name="toolTip"><string>more than 20 mm of accumulated rainfall in 4 days, with at least 2 days of rainfall &gt;= 1 mm, not followed by a period of 10 consecutive days with rainfall &lt; 1 mm in the following 30 days</string></property>
             </widget>
            </item>
            <item row="13" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetZambia">
              <property name="text"><string>Zambia: 20 mm in 5 days with 3 rainy days, no dry spell longer than 10 days in the following 21 days</string></property>
              <property name="toolTip"><string>at least 20 mm of accumulated rainfall in 5 days, with at least 3 days of rainfall &gt;= 0.85 mm, not followed by a period of more than 10 consecutive days with rainfall &lt; 0.85 mm in the following 21 days</string></property>
             </widget>
            </item>
            <item row="14" column="0" colspan="3">
             <widget class="QCheckBox" name="onsetZimbabwe">
              <property name="text"><string>Zimbabwe: 20 mm in 2 days, no 10-day dry spell in the following 30 days</string></property>
              <property name="toolTip"><string>at least 20 mm of accumulated rainfall in 2 days, not followed by a period of 10 consecutive days with rainfall &lt; 1 mm in the following 30 days</string></property>
             </widget>
            </item>
            <item row="15" column="0" colspan="3">
             <widget class="QGroupBox" name="groupBox_diag">
              <property name="title"><string>Diagnostics</string></property>
              <layout class="QGridLayout" name="gridLayout_diag">
               <item row="0" column="0" colspan="6">
                <widget class="QCheckBox" name="checkBox_diagall">
                 <property name="text"><string>plot all diagnostics (all onset definitions at one location, one season)</string></property>
                 <property name="toolTip"><string>Runs every agronomic onset definition on the daily rainfall of the grid cell or station nearest to the given location, for the season starting in the given year, and plots them one above the other. Independent of the definitions selected above.</string></property>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QLabel" name="label_diaglat">
                 <property name="text"><string>Latitude:</string></property>
                </widget>
               </item>
               <item row="1" column="1">
                <widget class="QLineEdit" name="lineEdit_diaglat">
                 <property name="toolTip"><string>decimal degrees, negative south of the equator; must lie within the data domain</string></property>
                </widget>
               </item>
               <item row="1" column="2">
                <widget class="QLabel" name="label_diaglon">
                 <property name="text"><string>Longitude:</string></property>
                </widget>
               </item>
               <item row="1" column="3">
                <widget class="QLineEdit" name="lineEdit_diaglon">
                 <property name="toolTip"><string>decimal degrees, negative west of Greenwich; must lie within the data domain</string></property>
                </widget>
               </item>
               <item row="1" column="4">
                <widget class="QLabel" name="label_diagyear">
                 <property name="text"><string>Season:</string></property>
                </widget>
               </item>
               <item row="1" column="5">
                <widget class="QLineEdit" name="lineEdit_diagyear">
                 <property name="toolTip"><string>year in which the season starts, e.g. 2020 for the summer season from October 2020</string></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupBox_accum">
           <property name="title"><string>Onset and demise from anomalous accumulation</string></property>
           <layout class="QVBoxLayout" name="verticalLayout_accum">
            <item>
             <widget class="QCheckBox" name="onsetAccum">
              <property name="text"><string>onset, demise, duration and wet/dry season rainfall</string></property>
              <property name="toolTip"><string>Liebmann and Marengo method; start of the water year from harmonic analysis of the annual cycle (Dunning et al. 2016). Locations without a single rainy season are not processed</string></property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupBox_dwtp">
           <property name="title"><string>Dry-to-wet transition period (DWTP)</string></property>
           <layout class="QVBoxLayout" name="verticalLayout_dwtp">
            <item>
             <widget class="QCheckBox" name="onsetDWTP">
              <property name="text"><string>DWTP statistics and climatological envelope (up to two seasons)</string></property>
              <property name="toolTip"><string>First day, length, intensity, rainfall and wet/dry spell statistics of the dry-to-wet transition period, within climatological envelopes derived from the climatological period</string></property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="checkBox_dwtpsavefiltered">
              <property name="text"><string>save filtered daily rainfall (large file)</string></property>
              <property name="toolTip"><string>Writes the Butterworth-filtered daily rainfall used by the method to a separate file (_PR60)</string></property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QCheckBox" name="checkBox_plotmaps">
           <property name="text"><string>Plot maps of all output variables (slow for large domains)</string></property>
           <property name="toolTip"><string>One image per output variable, saved next to the output files. Gridded data only.</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="checkBox_parallelize">
           <property name="text"><string>Run in parallel</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="button_run">
           <property name="text"><string>Calculate</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="button_exit">
           <property name="text"><string>Exit</string></property>
          </widget>
         </item>
         <item>
          <spacer name="verticalSpacer">
           <property name="orientation"><enum>Qt::Vertical</enum></property>
           <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
          </spacer>
         </item>
        </layout>
       </widget>
      </widget>
      <widget class="QWidget" name="rightPanel">
       <layout class="QVBoxLayout" name="verticalLayoutRight">
        <item>
         <widget class="QGroupBox" name="runLogGroupBox">
          <property name="title"><string>Run Log</string></property>
          <layout class="QVBoxLayout" name="runLogLayout">
           <item>
            <widget class="QPlainTextEdit" name="logWindow"/>
           </item>
           <item>
            <widget class="QPushButton" name="clearLogButton">
             <property name="text"><string>Clear Log</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <resources/>
 <connections/>
</ui>
